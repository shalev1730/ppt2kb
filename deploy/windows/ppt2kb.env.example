# PPT2KB desktop edition configuration - <install dir>\config\ppt2kb.env
# Use Start menu > PPT2KB > Edit configuration, then Stop/Start PPT2KB to apply.
# NO real credentials in this file. Values here are examples only.

# --- server ------------------------------------------------------------------
# The desktop edition always listens on 127.0.0.1 (this computer only).
PPT2KB_HOST=127.0.0.1
PPT2KB_PORT=8080
# Data (uploads, slide images, database, logs) defaults to %LOCALAPPDATA%\PPT2KB
# PPT2KB_DATA_DIR=D:\PPT2KB\data
# LibreOffice bundled with the installer is used automatically; override only if needed
# PPT2KB_LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# Secrets entered in the UI are stored encrypted with Windows DPAPI (current user)
PPT2KB_PERSIST_UI_SECRETS=true
PPT2KB_DESKTOP_MODE=true

# --- application -------------------------------------------------------------
PPT2KB_LOG_LEVEL=INFO
PPT2KB_LOG_JSON=false
PPT2KB_MAX_UPLOAD_MB=200
PPT2KB_MAX_SLIDES=300
PPT2KB_RETENTION_DAYS=30
PPT2KB_MAX_CONCURRENT_JOBS=1
# Log file (rotating). Default: %LOCALAPPDATA%\PPT2KB\logs\ppt2kb.log
# PPT2KB_LOG_FILE=
# Optional HTTP basic auth for the UI (recommended: SSO on the reverse proxy instead)
PPT2KB_UI_USERNAME=
PPT2KB_UI_PASSWORD=
# Lock outbound traffic to exactly these hosts (host or host:port, comma separated).
# When set, URLs entered in the UI must match one of them.
PPT2KB_ALLOWED_OUTBOUND_HOSTS=

# --- conversion sandbox ------------------------------------------------------
PPT2KB_CONVERSION_TIMEOUT_S=600
PPT2KB_CONVERSION_MEMORY_MB=3072
PPT2KB_CONVERSION_CPU_SECONDS=900
PPT2KB_IMAGE_WIDTH=1920
PPT2KB_IMAGE_HEIGHT=1080
PPT2KB_IMAGE_FORMAT=png

# --- Qwen Vision (OpenAI-compatible) -----------------------------------------
PPT2KB_QWEN_BASE_URL=
PPT2KB_QWEN_MODEL=Qwen2.5-VL-72B-Instruct
PPT2KB_QWEN_API_KEY=
PPT2KB_QWEN_AUTH_HEADER=Authorization
PPT2KB_QWEN_AUTH_SCHEME=Bearer
PPT2KB_QWEN_TIMEOUT_S=180
PPT2KB_QWEN_MAX_RETRIES=3
PPT2KB_QWEN_CONCURRENCY=4
PPT2KB_QWEN_RATE_LIMIT_PER_MIN=60
PPT2KB_QWEN_MAX_TOKENS=4096
PPT2KB_QWEN_TEMPERATURE=0.1
# --- v1.1: images and quality (all three can also be changed in the UI, Settings -> Images and quality)
# embedded      = Embedded Images Only: original images in the article body and attachments
# embedded_full = Embedded Images + Full Slides: full slides in the body; full slides + original images attached (default)
# full_slide    = Full Slides Only: full slides in the body and attachments
PPT2KB_IMAGE_ATTACHMENT_MODE=embedded_full
# true = slide backgrounds, layout/master graphics and repeated decoration are left out of the extracted images (default for new presentations)
PPT2KB_EXCLUDE_BACKGROUNDS=true
# answers that fail quality validation are re-requested this many times before the slide is held for review
PPT2KB_QWEN_QUALITY_RETRIES=1
# true = attachment names without Hebrew/non-ASCII characters (004_750_01.png instead of 004_משואה_750_01.png)
PPT2KB_ASCII_FILENAMES=false
# PPT2KB_QWEN_PROMPT_FILE=C:\path\to\prompt.txt
# PPT2KB_QWEN_EXTRA_BODY_JSON={"top_p":0.9}

# --- ServiceNow (Zurich, self-hosted) ----------------------------------------
PPT2KB_SERVICENOW_URL=
# basic | bearer | oauth_password
PPT2KB_SERVICENOW_AUTH_TYPE=basic
PPT2KB_SERVICENOW_USERNAME=
PPT2KB_SERVICENOW_PASSWORD=
# PPT2KB_SERVICENOW_TOKEN=
# PPT2KB_SERVICENOW_OAUTH_CLIENT_ID=
# PPT2KB_SERVICENOW_OAUTH_CLIENT_SECRET=
PPT2KB_SERVICENOW_TIMEOUT_S=120
PPT2KB_SERVICENOW_DEFAULT_KB=
PPT2KB_SERVICENOW_ATTACH_PPTX=false
# PPT2KB_SERVICENOW_EXTRA_FIELDS_JSON={"kb_category":"<sys_id>"}

# --- TLS ---------------------------------------------------------------------
# Internal CA chain (PEM). Copy it into the config folder and set the full path:
# PPT2KB_CA_BUNDLE=C:\Users\<you>\AppData\Local\Programs\PPT2KB\config\ca.pem
PPT2KB_CA_BUNDLE=
PPT2KB_TLS_VERIFY=true
# PPT2KB_CLIENT_CERT=/certs/client.pem
# PPT2KB_CLIENT_KEY=/certs/client.key
